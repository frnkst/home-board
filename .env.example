# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Immutable numeric GitHub user/provider ID (not the changeable login name).
# Find it at https://api.github.com/users/YOUR_LOGIN under the "id" field.
ADMIN_GITHUB_USER_ID=12345678

# Optional: enables hourly AI-generated clothing advice for the weather display.
OPENROUTER_API_KEY=
